{
  "apiVersion": "capabilities.murchalka.dev/v1",
  "kind": "CapabilityContract",
  "metadata": {
    "id": "conformance.echo",
    "version": "1.0.0",
    "category": "tool.callable",
    "description": "Echoes bounded MCP conformance input."
  },
  "request": {
    "schema": "conformance.echo.request.schema.json"
  },
  "response": {
    "schema": "conformance.echo.response.schema.json"
  },
  "semantics": {
    "interaction": "requestResponse",
    "sideEffect": "none",
    "idempotency": "required",
    "streaming": false,
    "cancellation": "required",
    "defaultTimeout": "30s",
    "maxPayloadBytes": 65536
  },
  "security": {
    "inputDataClasses": [
      "untrusted"
    ],
    "outputDataClasses": [
      "internal"
    ],
    "requiredPurpose": "external-protocol-request"
  },
  "errors": [
    {
      "code": "deadline-exceeded",
      "retryable": true,
      "description": "The bounded conformance operation timed out."
    }
  ]
}

